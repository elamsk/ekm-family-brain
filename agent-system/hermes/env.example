# ============================================================================
# Copy to $HERMES_HOME/.env  (default /opt/hermes/data/.env) and fill in.
#   chmod 600 $HERMES_HOME/.env
#
# THIS FILE IS THE EXAMPLE. The real .env is git-ignored and must never be
# committed, pasted into chat, or included in a GitHub repo.
# ============================================================================

# --- Primary brain: Google AI Studio (Gemini). Phase 1.2 ---
# Hermes accepts GEMINI_API_KEY or GOOGLE_API_KEY for the `gemini` provider.
GEMINI_API_KEY=

# --- Telegram front door. Phase 7 ---
# From @BotFather. The bot only answers the IDs in config.yaml telegram.allowed_chats.
TELEGRAM_BOT_TOKEN=

# --- Google Workspace APIs for the AGENT'S OWN account. Phase 3 + 6 ---
# OAuth client from Google Cloud Console (Desktop app type). The refresh token
# is written by the OAuth flow into $HERMES_HOME and is not stored here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: web search for the daily news brief. Phase 8.1 ---
# Hermes' `web` toolset accepts any one of these. Leave blank to skip.
TAVILY_API_KEY=
EXA_API_KEY=

# --- GitHub push for the nightly backup. Phase 4 + 5 ---
# A fine-grained PAT scoped to ONLY the family-brain and agent-system repos,
# Contents: read/write. Not a classic token, not org-wide.
GITHUB_TOKEN=
