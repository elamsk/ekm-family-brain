# These files are executed on Linux. A Windows checkout with core.autocrlf=true
# would rewrite them to CRLF, and `#!/usr/bin/env bash\r` is not a valid
# interpreter — the script then fails with:
#   /usr/bin/env: 'bash\r': No such file or directory
# Forcing eol=lf here makes the checkout correct on every platform.
* text=auto eol=lf

*.sh      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.env     text eol=lf
Dockerfile text eol=lf
